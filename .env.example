# Image to pull from GitHub Container Registry
DOCKER_IMAGE=ghcr.io/babdor/daddy_bv:latest

# Host LLM connection (Ollama)
OLLAMA_HOST=http://host.docker.internal:11434

# Serial interface on container (/dev/ttyUSB0 mapped via device string below)
SERIAL_PORT=/dev/ttyUSB0

# Serial device path on host machine
SERIAL_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
